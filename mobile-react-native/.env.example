# Copy to .env.local and fill in. .env.local is gitignored and must never be
# committed. Expo loads it automatically; `npx expo start` prints which keys it
# exported, which is the quickest way to tell a missing file from a typo.

# --- Supabase ---
# Both are safe in the bundle. The anon key is protected by Row Level Security,
# and every table in this project has real policies — see SECURITY.md.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ┌─ WHAT MUST NEVER APPEAR IN THIS FILE ──────────────────────────────────────┐
# │                                                                            │
# │ SUPABASE_SERVICE_ROLE_KEY. It bypasses RLS entirely, and a mobile bundle   │
# │ is not a secret — it is a file on a phone that anyone can unzip. Shipping  │
# │ it would hand every installed copy of the app the ability to read every    │
# │ family's records and grant itself any tier.                                │
# │                                                                            │
# │ Nothing in this app needs it. The writes that used to want it (spending a  │
# │ chat, enforcing the plan) live in database triggers instead — migration    │
# │ 0011. If a feature here seems to need the service key, the design is       │
# │ wrong, not the rule.                                                       │
# │                                                                            │
# │ DATABASE_URL does not belong here either. Migrations are applied in the    │
# │ Supabase SQL editor from supabase/manual/*-step-*.sql.                     │
# │                                                                            │
# └────────────────────────────────────────────────────────────────────────────┘
