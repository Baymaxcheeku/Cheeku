{
  "expo": {
    "name": "Cheeku AI",
    "slug": "cheeku-ai",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "cheekuai",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "in.cheekuai.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Cheeku AI uses the camera so you can photograph a report, prescription or scan and file it against a family member.",
        "NSPhotoLibraryUsageDescription": "Cheeku AI needs access to your photos so you can upload medical documents you have already saved.",
        "NSFaceIDUsageDescription": "Cheeku AI can lock your family's medical records behind Face ID."
      }
    },
    "android": {
      "package": "in.cheekuai.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#4a2ade"
      },
      "permissions": [
        "CAMERA",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_RESTING_HEART_RATE",
        "android.permission.health.READ_HEART_RATE_VARIABILITY",
        "android.permission.health.READ_OXYGEN_SATURATION",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_BLOOD_PRESSURE",
        "android.permission.health.READ_BLOOD_GLUCOSE",
        "android.permission.health.READ_EXERCISE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Cheeku AI needs access to your photos so you can upload medical documents you have already saved.",
          "cameraPermission": "Cheeku AI uses the camera so you can photograph a report, prescription or scan."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Cheeku AI can lock your family's medical records behind Face ID."
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#fafafe",
          "imageWidth": 200
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "color": "#4a2ade"
        }
      ],
      "expo-status-bar",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Cheeku AI uses your location while the app is open to show doctors, labs, pharmacies and classes near you and to fill in home visit addresses. You can turn it off or wipe it in Profile, Location."
        }
      ],
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsImageWithMaxCount": 1,
            "NSExtensionActivationSupportsFileWithMaxCount": 1
          },
          "iosShareExtensionName": "Cheeku AI",
          "androidIntentFilters": [
            "image/*",
            "application/pdf"
          ]
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Cheeku AI reads your steps, sleep, heart rate, workouts and other readings from Apple Health to show your trends and shape your daily plan. It never writes to Apple Health.",
          "NSHealthUpdateUsageDescription": false,
          "background": false
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
