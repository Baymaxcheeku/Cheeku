# Copy to .env.local and fill in. .env.local is gitignored and must never be committed.

# --- Supabase ---
# Safe to expose to the browser; protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses RLS entirely. Never import this into a client component.
# If a feature seems to need this in the browser, the architecture is wrong.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI ---
# "mock" uses lib/ai/mock. No live provider is implemented in V1.
NEXT_PUBLIC_AI_MODE=mock

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
