# Copy to .env.local and fill in. .env.local is gitignored and must never be committed.

# --- Supabase ---
# Read by scripts/seed.ts and tests/db. The NEXT_PUBLIC_ prefix is kept so
# existing .env.local files keep working; the mobile app has its own .env.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses RLS entirely. Used by the seed and the isolation test;
# it must never reach the mobile app.
SUPABASE_SERVICE_ROLE_KEY=

# SERVER ONLY, local tooling. Direct Postgres connection used by `pnpm db:migrate`
# and `pnpm db:reset`. Dashboard → Connect → Session pooler. Contains the database
# password, so it is never read by the app itself — only by scripts/migrate.ts.
DATABASE_URL=
