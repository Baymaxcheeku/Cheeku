{
  "name": "cheeku-ai-backend-tools",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "seed:reset": "tsx --env-file-if-exists=.env.local scripts/seed.ts --reset",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:reset": "tsx --env-file-if-exists=.env.local scripts/migrate.ts --reset"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.110.8",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "pg": "^8.22.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
